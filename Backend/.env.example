# --- Database -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cit404

# --- Auth -----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-the-event
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=1

# --- Server ---------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5174,http://localhost:4173

# --- Seeding --------------------------------------------------------
SEED_TEAM_COUNT=12
SEED_STARTING_BALANCE=150
SEED_ADMIN_USER=core_admin
# Leave blank to have a random password generated and printed once.
SEED_ADMIN_PASSWORD=

# --- DCR (Data Core Retrieval) --------------------------------------
# Restricted read-only Neon connection; never use the owner URL here.
DCR_DATABASE_URL=
# Must match the pepper used to produce answer_hashes.json (24+ chars).
ANSWER_PEPPER=

# --- Private challenge seeding --------------------------------------
# Set JSON in hosting secrets, or use a gitignored local private file.
CHALLENGE_SECRETS_JSON=
SEED_SUPERADMIN_USERS=Abdelgha44,walidreg
SEED_MISSION_ADMIN_USERS=admin1,admin2,admin3,admin4
