# CIT CTF challenge-host — environment template.
#
# Copy to `.env` and fill in REAL values on the host only. NEVER commit the
# real .env. These are placeholders — no real flags live in this repo.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# -----------------------------------------------------------------------------
# Per-challenge flags (each service gets ONLY its own flag).
# Use your event's real flag format, e.g. CIT{...}.
# -----------------------------------------------------------------------------
FLAG_SQLI=CIT{REPLACE_ME_SQLI}
FLAG_IDOR=CIT{REPLACE_ME_IDOR}
FLAG_EVALJAIL=CIT{REPLACE_ME_EVALJAIL}

# -----------------------------------------------------------------------------
# Public DNS + TLS. Point these subdomains at the EC2 Elastic IP:
#   sqli.<CHALLENGE_DOMAIN>   -> SQLi challenge
#   idor.<CHALLENGE_DOMAIN>   -> IDOR challenge
# -----------------------------------------------------------------------------
CHALLENGE_DOMAIN=chall.example.com
CADDY_ACME_EMAIL=admin@example.com
